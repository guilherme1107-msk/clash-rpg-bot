EMOJI_COIN_HEADS=
EMOJI_COIN_UNBREAKABLE=
EMOJI_COIN_UNBREAKABLE_HEADS=
EMOJI_OFFENSE_LEVEL=
EMOJI_DEFENSE_LEVEL=
EMOJI_CLASH_UP=
EMOJI_CLASH_DOWN=
EMOJI_ATTACK_UP=
EMOJI_ATTACK_DOWN=
EMOJI_PARALYZE=
