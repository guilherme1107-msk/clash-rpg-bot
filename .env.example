# Obrigatório. Nunca publique o token real.
DISCORD_TOKEN=cole_seu_token_aqui

# Discord Activity. O Client ID pode ser o Application ID do mesmo bot.
# O Client Secret fica em Developer Portal > OAuth2 e nunca deve ir ao GitHub.
DISCORD_CLIENT_ID=cole_o_application_id_aqui
DISCORD_CLIENT_SECRET=cole_o_client_secret_aqui
ACTIVITY_PORT=8780
ACTIVITY_INSTANCE_LOCK_PORT=47880

# Opcional durante desenvolvimento. Separe múltiplos servidores com vírgula.
DISCORD_GUILD_ID=123456789012345678
DATABASE_PATH=clash_rpg.sqlite3

# Arena opcional. Fora deste servidor, o Clash permanece no canal de origem.
CLASH_GUILD_ID=949911180841975849
CLASH_CHANNEL_ID=1536852812623908874
# Vários servidores: servidor:canal, separados por vírgula. Esta lista tem prioridade.
CLASH_CHANNELS=949911180841975849:1536852812623908874,1392000415108960426:1536852944518127748

# Canal privado que recebe uma cópia de todos os logs do terminal.
AUDIT_CHANNEL_ID=1537565714356117565
# Canal da Sentinela: recebe somente falhas e divergências técnicas.
DIAGNOSTIC_CHANNEL_ID=1543420686058524702
PRIVATE_SKILL_OWNER_ID=1034518001535430777
APPEARANCE_CHANNEL_ID=1537587461629280266
BOT_INSTANCE_LOCK_PORT=47653

# URLs diretas opcionais para GIFs próprios ou licenciados.
UNBREAKABLE_FOLLOWUP_GIF=
DAMAGE_RESOLUTION_GIF=

